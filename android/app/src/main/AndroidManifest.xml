<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgriChain"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.FarmerActivity"
            android:exported="false"
            android:label="Farmer" />

        <activity
            android:name=".ui.BuyerActivity"
            android:exported="false"
            android:label="Buyer" />

        <activity
            android:name=".batch.RegisterBatchActivity"
            android:exported="false"
            android:label="Register batch" />

        <activity
            android:name=".batch.BatchQrActivity"
            android:exported="false"
            android:label="Batch QR" />

        <activity
            android:name=".qr.ScanActivity"
            android:exported="false"
            android:label="Scan batch QR" />

        <activity
            android:name=".buyer.BuyerHistoryActivity"
            android:exported="false"
            android:label="Batch history" />

        <activity
            android:name=".barter.BarterActivity"
            android:exported="false"
            android:label="Barter" />

        <activity
            android:name=".box.BoxActivity"
            android:exported="false"
            android:label="Transport box" />

        <activity
            android:name=".prices.PricesActivity"
            android:exported="false"
            android:label="Mandi prices" />
    </application>

</manifest>
